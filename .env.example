# LiveKit sunucu adresi (LiveKit Cloud veya self-hosted)
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Opsiyonel: Katılım ekranına ön-doldurulacak hazır token.
# Token bu uygulamada ÜRETİLMEZ — dışarıda üretilir:
#   - LiveKit Cloud dashboard'un token üretici ekranı, veya
#   - LiveKit CLI:  lk token create --identity talha --room incident-test --join --valid-for 24h
# API SECRET ASLA buraya/koda konmaz. Boş bırakırsan token'ı uygulamada elle yapıştırırsın.
EXPO_PUBLIC_LIVEKIT_TOKEN=
